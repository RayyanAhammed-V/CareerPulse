<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="root-pane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.careerpulse.controller.RecruiterDashboardController">
    <left>
        <VBox styleClass="sidebar" spacing="10" prefWidth="250">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10"/>
            </padding>
            <Label text="CAREERPULSE" styleClass="sidebar-title"/>
            
            <Button text="Search Candidates" styleClass="nav-button, nav-active" maxWidth="Infinity"/>
            <Button text="My Shortlist" styleClass="nav-button" maxWidth="Infinity"/>
            
            <Region VBox.vgrow="ALWAYS" />
            <Button text="Logout" onAction="#handleLogout" styleClass="nav-button, danger-text" maxWidth="Infinity"/>
        </VBox>
    </left>
    
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>
            <Label text="Candidate Search" styleClass="page-title"/>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search by skills or name..." styleClass="input-field" HBox.hgrow="ALWAYS"/>
                <Button text="Search" styleClass="primary-button" onAction="#handleSearch"/>
            </HBox>

            <TableView fx:id="candidateTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameCol" text="Name" prefWidth="200"/>
                    <TableColumn fx:id="scoreCol" text="Employability Score" prefWidth="150"/>
                    <TableColumn fx:id="actionCol" text="Actions" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
