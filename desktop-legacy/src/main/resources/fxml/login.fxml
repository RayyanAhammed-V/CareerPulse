<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="root-pane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.careerpulse.controller.LoginController">
    <VBox alignment="CENTER" maxWidth="400" maxHeight="450" spacing="20" styleClass="card-pane">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="CAREERPULSE" styleClass="title-text" />
        <Label text="Sign in to your account" styleClass="subtitle-text" />

        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Email Address" styleClass="field-label" />
            <TextField fx:id="emailField" promptText="Enter your email" styleClass="input-field" />
        </VBox>

        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Password" styleClass="field-label" />
            <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="input-field" />
        </VBox>

        <Label fx:id="errorLabel" text="" styleClass="error-text" visible="false" managed="false"/>

        <Button text="Login" onAction="#handleLogin" maxWidth="Infinity" styleClass="primary-button" />
        
        <HBox alignment="CENTER" spacing="5">
            <Label text="Don't have an account?" styleClass="muted-text"/>
            <Hyperlink text="Register" onAction="#handleRegister" styleClass="link-text"/>
        </HBox>
    </VBox>
</StackPane>
